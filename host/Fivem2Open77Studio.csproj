<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows host of the fivem2open77 Studio: a WebView2 window around the local Studio server.
       .NET Framework 4.8 (part of Windows 10/11), so the exe needs no runtime install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>fivem2open77-studio</AssemblyName>
    <RootNamespace>Fivem2Open77.Studio</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.1</Version>
    <Company>fivem2open77</Company>
    <Product>fivem2open77 Studio</Product>
    <Description>Converts FiveM cars into Open77 (Cyberpunk 2077 multiplayer) cars</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
